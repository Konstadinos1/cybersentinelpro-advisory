# Copy to .env and fill in. Never commit the real file.
# Generate each value with: python -c 'import secrets; print(secrets.token_urlsafe(48))'

# HS256 key shared with the identity provider that issues user tokens (min 32 chars).
AEGIS_IDENTITY_SECRET=
# Key used by approval channels to sign human approvals (min 32 chars).
AEGIS_APPROVAL_KEY=
# Key that authenticates the tool pin lock file (CLI pin/verify).
AEGIS_MANIFEST_KEY=

AEGIS_ISSUER=https://idp.example.com
AEGIS_AUDIENCE=aegis-mcp

# Comma-separated canary strings planted in system prompts.
AEGIS_CANARIES=
# Optional path to a YAML file replacing src/aegis/default_config.yaml.
AEGIS_CONFIG_PATH=
# Set to 1 only for local demos: random keys, attack lab UI and /docs enabled.
AEGIS_LAB_MODE=
